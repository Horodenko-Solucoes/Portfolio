# Chave da API do Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Para onde chegam as mensagens do formulário
CONTACT_TO_EMAIL=contato@horodenko.com.br

# Remetente. Até verificar seu domínio no Resend, use o padrão abaixo
# (nesse modo o Resend só entrega para o e-mail da sua própria conta).
CONTACT_FROM_EMAIL="Site Horodenko <onboarding@resend.dev>"
